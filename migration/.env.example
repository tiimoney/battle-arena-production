# Firestore project to read from (read-only -- this tooling never writes to Firebase)
FIREBASE_PROJECT_ID="battle-arena-production"

# Path to a Firebase service account JSON key with at least Firestore read access.
# Generate one in the Firebase console: Project settings -> Service accounts ->
# Generate new private key. Keep this file OUT of git.
GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"

# Same Postgres/Neon connection string as server/.env -- migrate.ts writes here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
