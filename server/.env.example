# Neon connection strings (or any Postgres). Get these from your Neon project dashboard
# -- DATABASE_URL is the pooled (pgbouncer) endpoint for normal query traffic,
# DIRECT_URL is the unpooled endpoint `prisma migrate` needs for advisory locks.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Long random string used to sign JWTs -- generate with e.g. `openssl rand -hex 32`
JWT_SECRET="change-me"

PORT=4000

# Origin the client dev server runs on, for CORS + cookie settings
CLIENT_ORIGIN="http://localhost:5173"

# Publicly reachable base URL of THIS server -- used to build the link inside
# verification emails (GET {PUBLIC_API_URL}/auth/verify-email?token=...).
PUBLIC_API_URL="http://localhost:4000"

# Resend (resend.com) API key for sending verification emails. Get one free at
# resend.com -- no credit card needed. Leave unset in dev and emails just get logged
# to the console instead of actually sending.
RESEND_API_KEY=""
# Must be a verified sending domain in your Resend account, or their shared sandbox
# address (only deliverable to your own Resend account email) for testing.
EMAIL_FROM="Mocheso League <onboarding@resend.dev>"
