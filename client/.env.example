# Firebase web config -- not secret (it's meant to ship in the client bundle; real
# security is Firebase Auth + Firestore Security Rules). Defaults are already baked
# into src/firebase.ts for the battle-arena-production project, so these are only
# needed if you ever point this app at a different Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" (in client/.env.local, which is gitignored) to point the client at a
# local `firebase emulators:start` instead of the real project.
VITE_USE_EMULATOR=
